<Window x:Class="GravityDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="GRAVITY" Width="1280" Height="860"
        WindowStartupLocation="CenterScreen"
        Foreground="#FFE2EEF5" FontFamily="Segoe UI">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF0A1522" Offset="0"/>
            <GradientStop Color="#FF10253C" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF0E2233"/>
            <Setter Property="Foreground" Value="#FF00E5FF"/>
            <Setter Property="BorderBrush" Value="#FF00E5FF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF00E5FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FF102336"/>
            <Setter Property="Foreground" Value="#FFE2EEF5"/>
            <Setter Property="BorderBrush" Value="#FF1E3A55"/>
            <Setter Property="RowBackground" Value="#FF102336"/>
            <Setter Property="AlternatingRowBackground" Value="#FF0D1D2E"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFE2EEF5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#FF00E5FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FF0D1D2E"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="290"/>
        </Grid.RowDefinitions>

        <!-- ======= EN-TÊTE ======= -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="GRAVITY" FontSize="22" FontWeight="Bold" Foreground="#FF00E5FF" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="14" Color="#FF00E5FF" ShadowDepth="0" Opacity="0.7"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="  //  POSTE DE COMMANDEMENT" FontSize="12" Foreground="#FFFF2D95"
                       VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FFEF4444" Margin="24,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Connexion…" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#FF8FB8D9"/>
            <Button x:Name="OpenChatButton" Content="◉ GRAVITY AI" Click="OpenChatButton_Click"
                    Margin="22,0,0,0" BorderBrush="#FFFF2D95" Foreground="#FFFF2D95"/>
        </StackPanel>

        <!-- ======= MILIEU ======= -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Colonne A : equipage -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="▸ ÉQUIPAGE" Style="{StaticResource SectionHeader}"/>
                <Border Grid.Row="1" Background="#FF102336" BorderBrush="#FF1E3A55"
                        BorderThickness="1" CornerRadius="8">
                    <ListBox x:Name="CrewList" SelectionChanged="CrewList_SelectionChanged"
                             Background="Transparent" Foreground="#FFE2EEF5" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF134B63"/>
                                        <Setter Property="Foreground" Value="#FF00E5FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Colonne B : indicateurs + graphe -->
            <Grid Grid.Column="1" Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock x:Name="CrewTitle" Text="Sélectionner un membre" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Score :" Margin="20,0,6,0" VerticalAlignment="Center" Foreground="#FF8FB8D9"/>
                    <TextBlock x:Name="ScoreText" Text="" FontSize="18" FontWeight="Bold" Foreground="#FF00E5FF" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#FF00E5FF" ShadowDepth="0" Opacity="0.6"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
                <DataGrid x:Name="IndicatorsGrid" Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INDICATEUR" Binding="{Binding Ind}" Width="*"/>
                        <DataGridTextColumn Header="VALEUR" Binding="{Binding Valeur}" Width="90"/>
                        <DataGridTextColumn Header="BASELINE" Binding="{Binding Baseline}" Width="90"/>
                        <DataGridTextColumn Header="ÉCART %" Binding="{Binding EcartPct}" Width="90"/>
                        <DataGridTextColumn Header="ÉTAT" Binding="{Binding Etat}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Etat}" Value="OK">
                                            <Setter Property="Foreground" Value="#FF2EE6A8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etat}" Value="Surveillance">
                                            <Setter Property="Foreground" Value="#FFFCB64E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etat}" Value="Critique">
                                            <Setter Property="Foreground" Value="#FFFF5C7A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,5">
                    <TextBlock Text="▸ ÉVOLUTION" Style="{StaticResource SectionHeader}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="IndicatorSelector" Width="230" Padding="5,2"
                              SelectionChanged="IndicatorSelector_SelectionChanged"/>
                    <TextBlock x:Name="ChartInfo" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="#FF8FB8D9" FontSize="11.5"/>
                </StackPanel>
                <Border Grid.Row="3" Background="#FF0F2033" BorderBrush="#FF1E3A55"
                        BorderThickness="1" CornerRadius="8">
                    <lvc:CartesianChart x:Name="TrendChart" Background="Transparent" Margin="6"/>
                </Border>
            </Grid>

            <!-- Colonne C : plan -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PlanTitle" Text="▸ PLAN DE REMISE EN FORME" Style="{StaticResource SectionHeader}"/>
                <Button x:Name="GeneratePlanButton" Grid.Row="1" Content="⚡ Générer le plan"
                        Click="GeneratePlanButton_Click" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                <Border Grid.Row="2" Background="#FF102336" BorderBrush="#FF1E3A55"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PlanContent" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="#FFCFE6F5"
                                   Text="Sélectionne un membre puis clique sur « Générer le plan »."/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ======= BAS : alertes ======= -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="▸ ALERTES" Style="{StaticResource SectionHeader}"/>
            <DataGrid x:Name="AlertsGrid" Grid.Row="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CREW" Binding="{Binding CrewId}" Width="60"/>
                    <DataGridTextColumn Header="INDICATEUR" Binding="{Binding IndicatorFr}" Width="200"/>
                    <DataGridTextColumn Header="NIVEAU" Binding="{Binding Level}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="critical">
                                        <Setter Property="Foreground" Value="#FFFF5C7A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="alert">
                                        <Setter Property="Foreground" Value="#FFFCB64E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="tendance">
                                        <Setter Property="Foreground" Value="#FF00E5FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>