<Window x:Class="GravityDashboard.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="◉ GRAVITY AI" Width="520" Height="620"
        WindowStartupLocation="CenterOwner"
        Foreground="#FFE2EEF5" FontFamily="Segoe UI">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF0A1522" Offset="0"/>
            <GradientStop Color="#FF10253C" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#FF0D1D2E" BorderBrush="#FF1E3A55" BorderThickness="1"
                CornerRadius="8">
            <ListBox x:Name="ChatList" Background="Transparent" BorderThickness="0" Margin="4">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF102336" BorderBrush="#FF1E3A55" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="4"
                                HorizontalAlignment="{Binding Align}" MaxWidth="420">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ChatInput" VerticalAlignment="Center" Padding="6"
                     Background="#FF0D1D2E" Foreground="#FFE2EEF5" BorderBrush="#FF2A4A66"
                     KeyDown="ChatInput_KeyDown"/>
            <Button Grid.Column="1" Content="Envoyer" Click="SendButton_Click" Margin="6,0,0,0"/>
        </Grid>
    </Grid>
</Window>